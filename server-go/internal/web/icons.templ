// batteryIcon mirrors batteryIcon() from app/src/lib/battery.ts: the charge
// flow wins, then SOC thresholds (80/30/20). Static per render: the icon
// refreshes on page navigation, texts update live via signals.
templ iconBattery(class string, soc float64, charging bool) {
	if charging {
		@iconBatteryCharging(class)
	} else if soc >= 80 {
		@iconBatteryFull(class)
	} else if soc > 30 {
		@iconBatteryMedium(class)
	} else if soc > 20 {
		@iconBatteryLow(class)
	} else {
		@iconBatteryWarning(class)
	}
}

