// iconForStat maps the battery stat rows to their icon.
func iconForStat(key string, class string) templ.Component {
	switch key {
	case "arrowDown":
		return iconArrowDownToLine(class)
	case "arrowUp":
		return iconArrowUpFromLine(class)
	case "refresh":
		return iconRefreshCw(class)
	case "pulse":
		return iconHeartPulse(class)
	case "thermo":
		return iconThermometer(class)
	case "clock":
		return iconClock(class)
	}
	return iconActivity(class)
}

