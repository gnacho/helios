// brandLogo is the vectorized Helios mark (solar disk), copied from
// app/src/components/BrandLogoIcon.tsx. The gradient id is a parameter so
// several instances per page keep unique ids.
templ brandLogo(id string, class string) {
	<svg viewBox="0 0 629 629" class={ class } role="img" aria-label="Helios">
		<defs>
			<linearGradient id={ id } x1="0" y1="0" x2="1" y2="1" gradientUnits="objectBoundingBox">
				<stop offset="0" stop-color="#FBBF24"></stop>
				<stop offset="1" stop-color="#F97316"></stop>
