package web

import (
	"fmt"
	"strconv"
)

// /cargador page (port of Cargador.tsx). Tabs are links (?tab=key). The power
// and amperage buttons call the EXISTING JSON API (POST /api/charger/action)
// through Datastar: $charger/$action/$amps signals travel in the @post body
// (the handler ignores unknown keys) and $ui.busy/$ui.error carry the loading
// and error states. The image upload button (client-side canvas) is not ported.

templ ChargerPage(v chargerView) {
	@shellLayout(v.pageProps) {
		<div data-signals={ v.Signals } data-init={ "@get('/ui/stream')" } class="w-full">
			<!-- Panel de la pestaña activa: /ui/chg parchea solo esto al cambiar de cargador. -->
			<div id="chg-body" class="flex flex-col gap-4 lg:gap-5">
				<!--#chg-body-->
				if len(v.Tabs) > 1 {
					@chgTabs(v)
				}
				<!-- Track de los paneles: en movil se desliza con el dedo y ya
				     tiene pintada la vecina; en escritorio solo se ve la activa. -->
				if len(v.Panels) > 1 {
					<div class="overflow-hidden lg:overflow-visible" data-pager data-param="tab" data-active={ strconv.Itoa(v.ActiveIndex) }>
						<div class="flex w-full items-start will-change-transform" data-pager-track style={ pagerStyle(v.ActiveIndex) }>
							for _, pnl := range v.Panels {
								<div class={ "w-full shrink-0", templ.KV("lg:hidden", pnl.Key != v.Active.Key) } data-panel={ pnl.Key }>
									@chgSingle(v, pnl)
								</div>
							}
						</div>
					</div>
				} else if v.Active != nil {
					@chgSingle(v, v.Active)
				}
				<!--/#chg-body-->
			</div>
		</div>
	}
}

// chgTabs is the segmented control (sticky on mobile, like the React page).
templ chgTabs(v chargerView) {
	<div data-swipe-tabs class="sticky top-14 z-30 -mx-4 bg-[color-mix(in_srgb,var(--bg)_85%,transparent)] px-4 py-2 backdrop-blur-[16px] lg:static lg:mx-0 lg:bg-transparent lg:p-0 lg:backdrop-blur-none">
		<div class="flex h-10 w-full items-center gap-1 overflow-x-auto rounded-full border border-app bg-surface p-1 no-scrollbar lg:w-fit" role="tablist" aria-label={ T(v.Lang, "cargador.tabsAria") }>
			for _, tb := range v.Tabs {
				<a
					href={ templ.URL("/cargador?tab=" + tb.Key) }
					data-on:click__prevent={ chgTabSwapClick(tb.Key) }
					role="tab"
					aria-selected={ boolStr(tb.Active) }
					class={ "relative flex h-full flex-1 items-center justify-center gap-1.5 rounded-full px-4 text-sm font-medium transition-colors lg:flex-none", templ.KV("text-app", tb.Active), templ.KV("text-faint hover:text-muted", !tb.Active) }
				>
					if tb.Active {
						<span class="vt-slide-tab absolute inset-0 rounded-full bg-surface-2 shadow-inner"></span>
					}
					<span class="relative z-10 flex items-center gap-1.5">
						if tb.Charging {
							<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
						} else {
							<span class="h-2 w-2 rounded-full bg-faint opacity-40"></span>
						}
						{ tb.Name }
					</span>
				</a>
			}
		</div>
	</div>
}

templ chgSingle(v chargerView, s *chgSingleView) {
	<div class="grid grid-cols-1 gap-4 lg:grid-cols-12 lg:gap-5">
		@chgHero(v, s)
		<section class="helios-card col-span-12 shadow-card dark:shadow-card-dark" aria-label={ T(v.Lang, "cargador.todayAria") }>
			<div class="px-4 pb-1 pt-4 sm:px-5">
				<h2 class="text-[15px] font-semibold text-app">{ T(v.Lang, "cargador.todayTitle") }</h2>
				<p class="text-xs text-faint">{ T(v.Lang, "cargador.todaySubtitle") }</p>
			</div>
			<div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 px-4 pb-2 sm:px-5">
				for _, st := range s.Stats {
					<span class="inline-flex items-center gap-1.5 text-[13px] text-muted">
						@iconForChgStat(st.IconKey, "h-[13px] w-[13px] shrink-0 text-faint")
						{ st.Label }
						if st.Signal != "" {
							if st.AnimID != "" {
							<span class="font-semibold tabular-nums text-app">
								@animNumLiveS(st.AnimID, st.Num, st.Dec, v.Lang, st.Signal, st.Suffix)
							</span>
						} else {
							<span class="font-semibold tabular-nums text-app" data-text={ st.Signal }>{ st.Value }</span>
						}
						} else {
							<span class="font-semibold tabular-nums text-app">{ st.Value }</span>
						}
					</span>
				}
			</div>
			<div id={ "chg-curve-" + s.Key } data-on-interval__duration.60s={ "@get('/ui/chg-curve?key=" + s.Key + "')" }>
				@chgCurveSVG(s.Curve)
			</div>
		</section>
		<section id="historial-carga" class="helios-card col-span-12 scroll-mt-24 shadow-card dark:shadow-card-dark lg:col-span-8" aria-label={ T(v.Lang, "cargador.historyAria") }>
			<div class="flex flex-wrap items-center gap-2 px-4 pb-1 pt-4 sm:px-5">
				<div class="mr-auto">
					<h2 class="text-[15px] font-semibold text-app">{ T(v.Lang, "cargador.historyTitle") }</h2>
					<p class="text-xs capitalize text-faint">{ s.HistSub }</p>
					<p class="mt-0.5 text-xs text-faint">{ T(v.Lang, "cargador.historyHint") }</p>
				</div>
			</div>
			<div class="flex flex-wrap items-center gap-2 px-4 pb-2 sm:px-5">
				@chgPeriodNav(v, s)
			</div>
			<div class="flex flex-wrap items-center gap-3 px-4 pb-1 sm:px-5">
				<span class="inline-flex items-center gap-1.5 text-xs text-muted">
					<span class="h-2 w-2 rounded-full" style={ "background-color: " + s.Pal.Bateria }></span> { T(v.Lang, "cargador.fromSolar") }
				</span>
				<span class="inline-flex items-center gap-1.5 text-xs text-muted">
					<span class="h-2 w-2 rounded-full" style={ "background-color: " + s.Pal.Consumo }></span> { T(v.Lang, "cargador.fromGrid") }
				</span>
			</div>
			<div class="px-1">
				if !s.HistHasData {
					<div class="flex h-[220px] items-center justify-center px-6 text-center text-sm text-faint">
						{ T(v.Lang, "cargador.noHistory") }
					</div>
				} else {
					<div id={ "chg-hist-" + s.Key + "-" + string(s.Period) } class="w-full">
						@chgHistSVG(s.Hist)
					</div>
				}
			</div>
		</section>
		<section class="helios-card col-span-12 flex flex-col gap-5 p-5 shadow-card dark:shadow-card-dark sm:p-6 lg:col-span-4">
			<div>
				<p class="text-[11px] font-medium uppercase tracking-[0.08em] text-faint">{ T(v.Lang, "cargador.periodTotal") }</p>
				<p class="mt-1 font-display text-[28px] font-semibold leading-none tracking-[-0.01em] text-app">
					@animNum("chgTotal", s.TotalKwh, 1, v.Lang)
					<span class="text-[0.6em] font-medium text-faint">kWh</span>
				</p>
			</div>
			<div class="border-t border-app pt-5">
				<p class="text-[11px] font-medium uppercase tracking-[0.08em] text-faint">{ T(v.Lang, "cargador.fromSolar") }</p>
				<p class="mt-1 font-display text-[22px] font-semibold leading-none text-app">
					{ s.PctSolarText } <span class="text-[0.6em] font-medium text-faint">%</span>
				</p>
				<div class="mt-2.5 h-2 w-full overflow-hidden rounded-full bg-surface-2" role="progressbar" aria-valuenow={ s.PctSolarText } aria-valuemin="0" aria-valuemax="100" aria-label={ T(v.Lang, "cargador.pctSolarAria") }>
					<div class="anim-share h-full rounded-full" style={ "width: " + chgPctWidth(s.PctSolar) + "; background-color: " + s.Pal.Bateria }></div>
				</div>
				<p class="mt-1.5 text-sm text-muted">
					{ s.PvKwhText } kWh · { T(v.Lang, "cargador.fromGrid") }: { s.RestKwhText } kWh
				</p>
			</div>
			<div class="border-t border-app pt-5">
				<p class="text-[11px] font-medium uppercase tracking-[0.08em] text-faint">{ T(v.Lang, "common.production") }</p>
				<p class="mt-1 font-display text-[22px] font-semibold leading-none text-app">
					{ s.ProdKwhText } <span class="text-[0.6em] font-medium text-faint">kWh</span>
				</p>
				<p class="mt-1.5 text-sm text-muted">{ T(v.Lang, "cargador.ofProduction", map[string]string{"pct": s.PctOfProdText}) }</p>
			</div>
			<div class="border-t border-app pt-5">
				<p class="text-[11px] font-medium uppercase tracking-[0.08em] text-faint">{ T(v.Lang, "cargador.avgDay") }</p>
				<p class="mt-1 font-display text-[22px] font-semibold leading-none text-app">
					{ s.AvgDayText } <span class="text-[0.6em] font-medium text-faint">kWh</span>
				</p>
			</div>
		</section>
	</div>
}

func chgPctWidth(pct float64) string {
	if pct > 100 {
		pct = 100
	}
	return fmt.Sprintf("%.1f%%", pct)
}

func iconForChgStat(key string, class string) templ.Component {
	switch key {
	case "clock":
		return iconClock(class)
	case "gauge":
		return iconGauge(class)
	case "sun":
		return iconSun(class)
	}
	return iconZap(class)
}

// chgHero is the photo + actions card.
templ chgHero(v chargerView, s *chgSingleView) {
	<section class="helios-card col-span-12 flex flex-col gap-4 p-5 shadow-card dark:shadow-card-dark sm:p-6">
		<div class="flex flex-wrap items-center gap-3">
			<h2 class="text-[17px] font-semibold text-app">{ s.Name }</h2>
			<!-- El chip sigue a $chg.KEY.state (texto, color e icono): un
			     cargador cargando no se queda en "En reposo" hasta recargar. -->
			<span class={ "inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-sm font-semibold", s.Chip.Cls } data-attr:class={ s.ChipClassExpr }>
				<span data-show={ s.ChipStateExpr + " == 'charging'" }>@iconBatteryCharging("h-[14px] w-[14px]")</span>
				<span data-show={ s.ChipStateExpr + " == 'connected'" }>@iconCable("h-[14px] w-[14px]")</span>
				<span data-show={ s.ChipStateExpr + " != 'charging' && " + s.ChipStateExpr + " != 'connected'" }>@iconPlugZap("h-[14px] w-[14px]")</span>
				<span data-text={ s.ChipTextExpr }>{ s.Chip.Text }</span>
			</span>
			if v.IsAdmin {
				<!-- Como el React: solo el icono; al elegir la foto se sube sola. -->
				<form method="post" action="/cargador/charger-image" enctype="multipart/form-data" class="ml-auto">
					<input type="hidden" name="charger" value={ s.Key }/>
					<label class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-app bg-surface text-muted transition-colors hover:bg-surface-2 hover:text-app" title={ T(v.Lang, "cargador.imageEdit") } aria-label={ T(v.Lang, "cargador.imageEdit") }>
						@iconImagePlus("h-[15px] w-[15px]")
						<input type="file" name="image" accept="image/png,image/jpeg,image/webp" class="sr-only" required data-autosubmit/>
					</label>
				</form>
			}
		</div>
		if v.ImgErr {
			<p class="rounded-xl border border-rose-500/40 bg-rose-500/10 px-3 py-2 text-sm text-rose-600 dark:text-rose-400">{ T(v.Lang, "cargador.imageError") }</p>
		}
		<div class="flex flex-col gap-5 lg:flex-row lg:items-stretch">
			<!-- La foto no participa en el flujo: si lo hiciera, su tamaño intrínseco
			     estiraría la tarjeta y cada cargador tendría un alto distinto. -->
			<div class="relative flex h-[190px] shrink-0 items-center justify-center overflow-hidden rounded-3xl bg-white p-3 lg:h-[274px] lg:w-[46%] dark:bg-transparent">
				if s.HasImage {
					<img src={ templ.URL(s.ImageURL) } alt={ s.Name } draggable="false" class="chg-photo absolute inset-3 h-[calc(100%-1.5rem)] w-[calc(100%-1.5rem)] object-contain select-none"/>
				} else {
					@iconCarFront("h-[72px] w-[72px]")
				}
			</div>
			<div class="flex min-w-0 flex-1 flex-col justify-center gap-[26px] lg:max-w-[400px]">
				<!-- Amperaje y encendido: en pantallas estrechas se apilan (los
				     chips a ancho completo y el boton debajo); en sm comparten
				     fila con el boton estrecho. -->
				<div class="flex flex-col gap-2 sm:flex-row sm:items-end">
					if s.HasAmps {
						<div class="min-w-0 flex-1">
							<span class="mb-2 block text-xs font-medium text-faint">{ s.AmpsLabel }</span>
							<div class="grid grid-cols-4 gap-1.5 sm:flex sm:flex-wrap sm:items-center" role="group" aria-label={ s.AmpsAria }>
								for _, chip := range s.AmpChips {
									<button
										type="button"
										aria-pressed={ chip.Aria }
										data-on:click={ chip.ClickExpr }
										data-indicator="$ui.busy"
										data-attr:disabled={ "$ui.busy" }
										data-attr:aria-pressed={ chip.AriaExpr }
										data-attr:class={ chip.ClassExpr }
										class={ ampClass(chip.Active) }
									>
										{ chip.AmpsText }
									</button>
								}
							</div>
						</div>
					}
					if s.PowerKnown {
						<!-- El estado, el color y la etiqueta siguen a la señal: al
						     pulsar cambia al instante y muestra "Encendiendo…" hasta
						     que HA confirma (o 12 s sin noticias). -->
						<button
							type="button"
							data-on:click={ s.PowerClick }
							data-indicator="$ui.busy"
							data-on-interval__duration.500ms={ s.PendingClearExpr }
							data-attr:disabled={ "$ui.busy || $ui.pending != ''" }
							data-attr:aria-pressed={ s.PressedExpr }
							data-attr:title={ s.TitleExpr }
							data-attr:class={ s.ClassExpr }
							title={ s.PowerTitle }
							class={ "inline-flex h-12 w-full shrink-0 items-center justify-center sm:h-[60px] sm:w-[157px] gap-2 rounded-2xl px-2 text-sm font-semibold transition-colors disabled:opacity-50", templ.KV("bg-emerald-500/12 text-emerald-600 hover:bg-emerald-500/20 dark:text-emerald-400", s.PowerOn), templ.KV("bg-brand text-white hover:opacity-90", !s.PowerOn) }
						>
							<span data-show="$ui.pending == ''">@iconPower("h-5 w-5 shrink-0")</span>
							<span data-show="$ui.pending == ''" data-text={ s.LabelExpr }>{ s.PowerLabel }</span>
							<span data-show="$ui.pending != ''">@iconLoaderCircle("h-5 w-5 shrink-0 animate-spin")</span>
							<span data-show="$ui.pending != ''" data-text={ s.PendingExpr }>{ s.PendingText }</span>
						</button>
					} else {
						<button
							type="button"
							disabled
							aria-pressed="false"
							title={ s.PowerTitle }
							class="inline-flex h-12 w-full shrink-0 items-center justify-center sm:h-[60px] sm:w-[157px] gap-2 rounded-2xl bg-brand px-2 text-sm font-semibold text-white opacity-50"
						>
							@iconPower("h-5 w-5 shrink-0")
							{ s.PowerLabel }
						</button>
					}
				</div>
				<div data-show="$ui.error != ''" class="rounded-xl border border-rose-500/40 bg-rose-500/10 px-3 py-2 text-sm text-rose-600 dark:text-rose-400" data-text="$ui.error"></div>
				<!-- Fila de programación: mientras haya una programación armada
				     o la carga programada esté en marcha, el formulario se
				     oculta y se ve el estado (ventana u hora de fin) con el
				     botón Detener; en vivo vía $chg.KEY. -->
				if s.HasSchedule {
					<div class="flex flex-col gap-2">
						<div class="flex items-center justify-between gap-2" data-show={ s.ScheduleShowExpr }>
							<span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400" data-text={ s.ScheduleTextExpr }>{ s.ScheduleText }</span>
							if s.ScheduleCancel != "" {
								<button
									type="button"
									data-on:click={ s.ScheduleCancel }
									data-indicator="$ui.busy"
									data-attr:disabled="$ui.busy"
									class="inline-flex h-8 shrink-0 items-center justify-center rounded-full border border-app bg-surface px-3 text-xs font-semibold text-muted transition-colors hover:bg-surface-2 hover:text-app disabled:opacity-50"
								>
									{ T(v.Lang, "cargador.stopSchedule") }
								</button>
							}
						</div>
						<div class="flex flex-col gap-2" data-show={ s.ScheduleFormExpr }>
							<span class="text-xs font-medium text-faint">{ s.ScheduleLabel }</span>
							<div class="grid grid-cols-3 items-end gap-2 sm:grid-cols-[1fr_1fr_1fr_auto]">
								@chgDrop(T(v.Lang, "cargador.delay"), s.ScheduleHour)
								@chgDrop(T(v.Lang, "cargador.minutes"), s.ScheduleMinute)
								@chgDrop(T(v.Lang, "cargador.duration"), s.ScheduleDur)
								<button
									type="button"
									data-on:click={ s.ScheduleClick }
									data-indicator="$ui.busy"
									data-attr:disabled="$ui.busy"
									class="col-span-3 inline-flex h-11 w-full shrink-0 items-center justify-center rounded-xl bg-brand px-4 text-sm font-semibold text-white transition-opacity hover:opacity-90 disabled:opacity-50 sm:col-span-1 sm:w-auto"
								>
									{ s.ScheduleLabel }
								</button>
							</div>
						</div>
					</div>
				}
				<!-- Temperatura al final de la ficha (solo si el cargador
				     expone el sensor). -->
				if s.TempKnown {
					<div class="flex items-center gap-2 px-1">
						@iconThermometer("h-[15px] w-[15px] shrink-0 text-faint")
						<span class="text-[13px] text-muted">{ T(v.Lang, "cargador.temperature") }</span>
						<span class="text-[15px] font-semibold tabular-nums text-app" data-text={ "$chg." + s.Key + ".tempText" }>{ s.TempText }</span>
					</div>
				}
			</div>
		</div>
	</section>
}

// chgDrop is the schedule dropdown: a closed button with the selected label, a
// popover list and a hidden input. Native selects open a full screen wheel on
// Android, which hides the rest of the form.
templ chgDrop(label string, v chgSelectView) {
	<div data-drop class="relative min-w-0">
		<label class="mb-2 block text-xs font-medium text-faint">{ label }</label>
		<button
			type="button"
			data-drop-btn
			aria-haspopup="listbox"
			aria-expanded="false"
			class={ chgSelectClass + " flex w-full items-center justify-between gap-1 text-left" }
		>
			<span data-drop-label class="truncate">{ v.SelectedLabel }</span>
			<svg class="h-4 w-4 shrink-0 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</button>
		<div data-drop-panel role="listbox" class="absolute left-0 top-full z-40 mt-1 hidden max-h-60 w-full overflow-y-auto rounded-xl border border-app bg-surface p-1 shadow-xl">
			for _, o := range v.Options {
				if o.Selected {
					<button type="button" data-drop-opt data-value={ o.Value } data-label={ o.Label } aria-selected="true" class="flex h-9 w-full items-center rounded-lg bg-brand/10 px-2 text-sm font-semibold text-brand">{ o.Label }</button>
				} else {
					<button type="button" data-drop-opt data-value={ o.Value } data-label={ o.Label } aria-selected="false" class="flex h-9 w-full items-center rounded-lg px-2 text-sm text-app hover:bg-surface-2">{ o.Label }</button>
				}
			}
		</div>
		<input type="hidden" id={ v.ID } value={ v.SelectedValue }/>
	</div>
}

// ampClass devuelve las clases del chip segun su estado activo.
func ampClass(active bool) string {
	if active {
		return "inline-flex h-9 min-w-10 items-center justify-center rounded-xl border border-brand bg-brand/10 px-3 text-sm font-semibold tabular-nums text-brand transition-colors disabled:opacity-50"
	}
	return "inline-flex h-9 min-w-10 items-center justify-center rounded-xl border border-app bg-surface px-3 text-sm font-semibold tabular-nums text-muted transition-colors hover:bg-surface-2 hover:text-app disabled:opacity-50"
}

// chgPeriodNav is the period navigation of the charger history (same control
// as Histórico, semana/mes/año only).
templ chgPeriodNav(v chargerView, s *chgSingleView) {
	<div class="flex flex-wrap items-center gap-2 sm:gap-3">
		<div role="tablist" aria-label={ T(v.Lang, "historico.periodAria") } class="flex h-9 items-center rounded-full border border-app bg-surface p-0.5">
			for _, tb := range s.Sel.Tabs {
				<a
					href={ templ.URL(tb.URL) }
					data-on:click__prevent={ chgPeriodSwapClick(tb.URL) }
					role="tab"
					aria-selected={ boolStr(tb.Active) }
					class={ "relative flex h-8 items-center rounded-full px-3 text-[13px] font-medium transition-colors sm:px-3.5", templ.KV("text-app", tb.Active), templ.KV("text-faint hover:text-muted", !tb.Active) }
				>
					if tb.Active {
						<span class="vt-slide-period absolute inset-0 rounded-full bg-surface-2 shadow-inner"></span>
					}
					<span class="relative">{ tb.Label }</span>
				</a>
			}
		</div>
		<div class="flex h-9 items-center gap-0.5 rounded-full border border-app bg-surface p-0.5">
			<a href={ templ.URL(s.Sel.PrevURL) } data-on:click__prevent={ chgPeriodSwapClick(s.Sel.PrevURL) } aria-label={ s.Sel.PrevAria } class="flex h-8 w-8 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface-2 hover:text-app">
				@iconChevronLeft("h-4 w-4")
			</a>
			<div class="flex h-8 min-w-[92px] items-center justify-center overflow-hidden px-1 sm:min-w-[110px]">
				<span class="text-[13px] font-semibold tabular-nums text-app">{ s.NavLabel }</span>
			</div>
			if s.Sel.CanNext {
				<a href={ templ.URL(s.Sel.NextURL) } data-on:click__prevent={ chgPeriodSwapClick(s.Sel.NextURL) } aria-label={ s.Sel.NextAria } class="flex h-8 w-8 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface-2 hover:text-app">
					@iconChevronRight("h-4 w-4")
				</a>
			} else {
				<span aria-hidden="true" class="flex h-8 w-8 cursor-not-allowed items-center justify-center rounded-full text-faint opacity-50">
					@iconChevronRight("h-4 w-4")
				</span>
			}
		</div>
		if !s.Sel.IsCurrent {
			<a href={ templ.URL(s.Sel.TodayURL) } data-on:click__prevent={ chgPeriodSwapClick(s.Sel.TodayURL) } class="h-9 rounded-full border border-amber-500/40 px-3.5 text-[13px] font-semibold leading-9 text-amber-600 transition-transform hover:bg-amber-500/10 active:scale-95 dark:text-amber-400">
				{ T(v.Lang, "common.today") }
			</a>
		}
	</div>
}

// chgCurveSVG is the day charging curve (area, palette.consumo).
templ chgCurveSVG(c chgCurveModel) {
	<div class="overflow-x-auto px-1 pb-2 lg:overflow-visible">
		<svg viewBox="0 0 1160 220" class="anim-draw h-auto w-full min-w-[480px]" role="img" aria-hidden="true">
			<defs>
				<linearGradient id="chg-curve" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color={ c.Color } stop-opacity="0.35"></stop>
					<stop offset="100%" stop-color={ c.Color } stop-opacity="0.02"></stop>
				</linearGradient>
			</defs>
			for _, t := range c.TicksY[1:] {
				<line x1={ r2(34) } x2={ r2(c.PlotRightX) } y1={ r2(t.Y - 4) } y2={ r2(t.Y - 4) } stroke="var(--line)" stroke-opacity="0.6" stroke-dasharray="3 6"></line>
			}
			for _, t := range c.TicksY {
				<text x={ r2(t.X) } y={ r2(t.Y) } text-anchor="end" font-size="12" fill="var(--text-faint)" font-family="Inter">{ t.Label }</text>
			}
			for i, t := range c.TicksX {
				if i == len(c.TicksX)-1 {
					<text x={ r2(chgCurveW) } y={ r2(t.Y) } text-anchor="end" font-size="12" fill="var(--text-faint)" font-family="Inter">{ t.Label }</text>
				} else {
					<text x={ r2(t.X) } y={ r2(t.Y) } text-anchor="middle" font-size="12" fill="var(--text-faint)" font-family="Inter">{ t.Label }</text>
				}
			}
			if c.AreaPath != "" {
				<path d={ c.AreaPath } fill="url(#chg-curve)"></path>
				<path d={ c.LinePath } fill="none" stroke={ c.Color } stroke-width="2"></path>
			}
			@chartHoverLayer(c.Hover)
		</svg>
	</div>
}

// chgHistSVG is the stacked day/month/year history (pv solar + grid rest).
templ chgHistSVG(m chgHistModel) {
	<svg viewBox="0 0 757 220" class="anim-bars h-auto w-full min-w-[480px]" role="img" aria-hidden="true">
		for _, t := range m.TicksY[1:] {
			<line x1={ r2(34) } x2={ r2(m.PlotRightX) } y1={ r2(t.Y - 4) } y2={ r2(t.Y - 4) } stroke="var(--line)" stroke-opacity="0.6" stroke-dasharray="3 6"></line>
		}
		for _, t := range m.TicksY {
			<text x={ r2(t.X) } y={ r2(t.Y) } text-anchor="end" font-size="12" fill="var(--text-faint)" font-family="Inter">{ t.Label }</text>
		}
		for i, row := range m.Rows {
			// La barra apilada (solar + red) se anima como una unidad: si cada
			// tramo creciera por su cuenta, el de arriba levitaría.
			<g class="bar-up">
				if row.PvH > 0 {
					<rect x={ r2(row.X) } y={ r2(row.PvY) } width={ r2(row.BarW) } height={ r2(row.PvH) } fill={ m.ColorSolar }></rect>
				}
				if row.RestH > 0 {
					<rect x={ r2(row.X) } y={ r2(row.RestY) } width={ r2(row.BarW) } height={ r2(row.RestH) } rx="3" fill={ m.ColorGrid }></rect>
				}
			</g>
			if chgShowLabel(m.Rows, i) {
				<text x={ r2(row.X + row.BarW/2) } y={ r2(chgCurveH - 2) } text-anchor="middle" font-size="11" fill="var(--text-faint)" font-family="Inter">{ row.Label }</text>
			}
		}
		@chartHoverLayer(m.Hover)
	</svg>
}

// chgShowLabel mirrors the React minTickGap: with a month of ~30 daily
// columns only 1 of every 3 labels fits (React interval=2 on mes).
func chgShowLabel(rows []chgHistRow, i int) bool {
	_ = rows
	if len(rows) > 20 {
		return i%3 == 0
	}
	return true
}