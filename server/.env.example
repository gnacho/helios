# =============================================================================
# CONFIGURACIÓN HELIOS - Copiar a .env y rellenar valores reales
# =============================================================================

# --- Servidor ---
PORT=80

# --- Home Assistant ---
# URL de tu instancia HAOS (ej: http://192.168.10.244:8123)
HAOS_URL=http://192.168.10.244:8123
# Token de larga duración (HAOS → Profile → Long-Lived Access Tokens)
HAOS_TOKEN=pegar_aqui_long_lived_token

# --- Autenticación ---
# Usuario para login en la web
AUTH_USER=admin
# Contraseña (se hasheará con bcrypt en el primer arranque)
AUTH_PASS=cambiar_esto
# Secret para firmar cookies de sesión (generar con: openssl rand -hex 32)
SESSION_SECRET=

# --- Precios energía (para cálculos de ahorro) ---
PRICE_IMPORT_EUR=0.15
PRICE_EXPORT_EUR=0.08
CO2_KG_PER_KWH=0.25

# --- Rutas (opcional, usar defaults si no se especifica) ---
# DATA_DIR=/opt/helios/data
# STATIC_DIR=/opt/helios/public
