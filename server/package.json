{
  "name": "helios-server",
  "version": "0.8.25",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json && node --watch dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "HAOS_TOKEN=test AUTH_PASS=test vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.8",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "bcrypt@6.0.0": true
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
